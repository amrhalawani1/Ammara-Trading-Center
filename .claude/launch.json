{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atc-website",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "WEB_PORT=$PORT pnpm run dev:web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "atc-website-alt-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=8797",
        "API_ORIGIN=http://127.0.0.1:8797",
        "pnpm",
        "dev"
      ],
      "port": 5173
    }
  ]
}
