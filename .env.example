# Copy to .env and fill in local values. Never commit .env.

# Required for the API and database tools
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/atc

# API listen port (default 8080)
PORT=8080

# Frontend (Vite). Defaults are used if unset.
WEB_PORT=5173
BASE_PATH=/

# Optional. Comma-separated origins allowed by CORS in production.
# In development, localhost is always allowed.
CORS_ORIGIN=http://localhost:5173

# Clerk — optional. Unset keeps the public site working (Save, inquiry, showroom).
# When set: trade accounts at /account, staff door at /sign-in → /content.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Comma-separated Clerk user IDs allowed to manage catalogue content.
# Leave empty to keep the staff API fail-closed (503).
CONTENT_STAFF_USER_IDS=

# Optional
LOG_LEVEL=info
NODE_ENV=development
