{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "atc-website": {
      "root": "artifacts/atc-website",
      "framework": "vite",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "atc-website" } }
  ]
}
